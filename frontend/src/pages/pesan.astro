---
// pesan.astro - Apple macOS / iMessage & iTunes Inspired Messenger
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pusat Pesan | EasyMall macOS Edition</title>
    
    <!-- Favicon & App Icons -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    
    <style is:global>
        :root {
            --apple-bg: #f5f5f7;
            --apple-sidebar-bg: #f6f8fa;
            --apple-card-bg: #ffffff;
            --apple-blue: #007aff;
            --apple-blue-hover: #0066d6;
            --apple-blue-gradient: linear-gradient(180deg, #007aff 0%, #0062d2 100%);
            --apple-border: rgba(0, 0, 0, 0.08);
            --apple-text-main: #1d1d1f;
            --apple-text-muted: #86868b;
            --apple-text-secondary: #6e6e73;
            --apple-hover: rgba(0, 0, 0, 0.04);
            --apple-active: #e5f1ff;
            --font-apple: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-apple);
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--apple-bg);
            color: var(--apple-text-main);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Full Height Edge-to-Edge Desktop App Window (Mentok Full) */
        .macos-app-container {
            flex-grow: 1;
            height: calc(100vh - 62px);
            display: grid;
            grid-template-columns: 240px 320px 1fr;
            background: #ffffff;
            overflow: hidden;
            border-top: 1px solid var(--apple-border);
        }

        /* 1. Leftmost macOS Sidebar Navigation */
        .sidebar-col {
            background: var(--apple-sidebar-bg);
            border-right: 1px solid var(--apple-border);
            display: flex;
            flex-direction: column;
            padding: 1rem 0.75rem;
            gap: 4px;
            overflow-y: auto;
            height: 100%;
        }

        .macos-traffic-lights {
            display: flex;
            gap: 6px;
            padding: 0 8px 1rem 8px;
            align-items: center;
        }

        .traffic-dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            display: inline-block;
        }
        .dot-red { background: #ff5f56; border: 1px solid #e0443e; }
        .dot-yellow { background: #ffbd2e; border: 1px solid #dea123; }
        .dot-green { background: #27c93f; border: 1px solid #1aab29; }

        .macos-sidebar-nav-title {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--apple-text-muted);
            padding: 6px 12px 2px 12px;
        }

        .macos-nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 8px;
            color: var(--apple-text-secondary);
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .macos-nav-item:hover {
            background: var(--apple-hover);
            color: var(--apple-text-main);
        }

        .macos-nav-item.active {
            background: var(--apple-blue);
            color: #ffffff;
            font-weight: 600;
        }

        .macos-nav-item-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .macos-nav-badge {
            background: #ff3b30;
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 10px;
        }

        .macos-sidebar-divider {
            height: 1px;
            background: var(--apple-border);
            margin: 0.6rem 8px;
        }

        /* 2. Middle Panel: iTunes / iMessage Contacts List */
        .macos-contacts-panel {
            background: #ffffff;
            border-right: 1px solid var(--apple-border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .macos-search-header {
            padding: 1rem 1rem 0.75rem 1rem;
            border-bottom: 1px solid var(--apple-border);
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(15px);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .panel-header-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-header-title h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--apple-text-main);
            letter-spacing: -0.3px;
        }

        .apple-search-wrapper {
            position: relative;
            width: 100%;
        }

        .apple-search-input {
            width: 100%;
            padding: 8px 12px 8px 32px;
            background: rgba(118, 118, 128, 0.12);
            border: 1px solid transparent;
            border-radius: 8px;
            font-size: 0.85rem;
            color: var(--apple-text-main);
            outline: none;
            transition: all 0.2s ease;
        }

        .apple-search-input:focus {
            background: #ffffff;
            border-color: var(--apple-blue);
            box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.15);
        }

        .apple-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--apple-text-muted);
            pointer-events: none;
        }

        .macos-contacts-scroll {
            flex-grow: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            padding: 4px;
        }

        .apple-contact-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.15s ease;
            position: relative;
            margin-bottom: 2px;
        }

        .apple-contact-card:hover {
            background: var(--apple-hover);
        }

        .apple-contact-card.active {
            background: var(--apple-active);
        }

        .apple-avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .apple-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #007aff, #5856d6);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.05rem;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
        }

        .apple-online-indicator {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 11px;
            height: 11px;
            background: #34c759;
            border: 2px solid #ffffff;
            border-radius: 50%;
        }

        .apple-contact-content {
            flex-grow: 1;
            min-width: 0;
        }

        .contact-top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2px;
        }

        .apple-contact-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--apple-text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .apple-contact-time {
            font-size: 0.7rem;
            color: var(--apple-text-muted);
            font-weight: 400;
        }

        .contact-bottom-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
        }

        .apple-last-snippet {
            font-size: 0.8rem;
            color: var(--apple-text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex-grow: 1;
        }

        .apple-unread-dot {
            background: #007aff;
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 10px;
        }

        /* 3. Right Panel: Apple iMessage Workspace */
        .macos-chat-workspace {
            background: #ffffff;
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        .macos-chat-header {
            padding: 12px 20px;
            border-bottom: 1px solid var(--apple-border);
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 10;
        }

        .active-user-meta {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .active-user-name {
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--apple-text-main);
            letter-spacing: -0.2px;
        }

        .active-user-status {
            font-size: 0.75rem;
            color: #34c759;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .telegram-badge-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(0, 122, 255, 0.08);
            color: var(--apple-blue);
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            text-decoration: none;
            transition: background 0.15s;
        }

        .telegram-badge-tag:hover {
            background: rgba(0, 122, 255, 0.15);
        }

        /* Messages stream with Apple Bubbles */
        .macos-messages-stream {
            flex-grow: 1;
            padding: 1.5rem 2rem;
            overflow-y: auto;
            background: #fbfbfd;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scroll-behavior: smooth;
        }

        .imessage-wrapper {
            display: flex;
            flex-direction: column;
            max-width: 68%;
            animation: apple-msg-in 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes apple-msg-in {
            from { opacity: 0; transform: translateY(8px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .imessage-wrapper.sent {
            align-self: flex-end;
            align-items: flex-end;
        }

        .imessage-wrapper.received {
            align-self: flex-start;
            align-items: flex-start;
        }

        .imessage-sender-tag {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--apple-text-muted);
            margin-bottom: 3px;
            padding: 0 4px;
        }

        .imessage-bubble {
            padding: 10px 16px;
            border-radius: 18px;
            font-size: 0.92rem;
            line-height: 1.45;
            word-break: break-word;
            position: relative;
        }

        .imessage-wrapper.sent .imessage-bubble {
            background: var(--apple-blue-gradient);
            color: #ffffff;
            border-bottom-right-radius: 4px;
            box-shadow: 0 2px 8px rgba(0, 122, 255, 0.25);
        }

        .imessage-wrapper.received .imessage-bubble {
            background: #e9e9eb;
            color: #000000;
            border-bottom-left-radius: 4px;
        }

        .imessage-meta {
            font-size: 0.68rem;
            color: var(--apple-text-muted);
            margin-top: 4px;
            padding: 0 4px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Apple Capsule Message Input */
        .macos-input-bar {
            padding: 12px 18px;
            border-top: 1px solid var(--apple-border);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .imessage-input-capsule {
            flex-grow: 1;
            display: flex;
            align-items: center;
            background: rgba(118, 118, 128, 0.12);
            border: 1px solid transparent;
            border-radius: 22px;
            padding: 4px 6px 4px 16px;
            transition: all 0.2s ease;
        }

        .imessage-input-capsule:focus-within {
            background: #ffffff;
            border-color: var(--apple-blue);
            box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.15);
        }

        .imessage-text-input {
            flex-grow: 1;
            border: none;
            background: transparent;
            font-size: 0.92rem;
            outline: none;
            color: var(--apple-text-main);
            padding: 6px 0;
        }

        .imessage-send-arrow {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--apple-blue);
            color: #ffffff;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
            flex-shrink: 0;
        }

        .imessage-send-arrow:hover {
            transform: scale(1.08);
            background: var(--apple-blue-hover);
        }

        .imessage-send-arrow:disabled {
            background: #c7c7cc;
            transform: none;
            cursor: not-allowed;
        }

        /* Empty / No Chat Selected Screen */
        .apple-empty-chat {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-grow: 1;
            gap: 14px;
            color: var(--apple-text-secondary);
            text-align: center;
            padding: 2rem;
            background: #fbfbfd;
        }

        .apple-empty-icon {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: rgba(0, 122, 255, 0.1);
            color: var(--apple-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .back-mobile-button {
            display: none;
            background: transparent;
            border: none;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            padding: 4px 6px;
            color: var(--apple-blue);
            align-items: center;
            gap: 2px;
            border-radius: 8px;
            transition: background 0.15s ease;
        }

        .back-mobile-button:hover {
            background: rgba(0, 122, 255, 0.08);
        }

        .mobile-back-dash {
            display: none;
            color: var(--apple-blue);
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            align-items: center;
            gap: 4px;
        }

        /* Mobile Adjustments */
        @media (max-width: 900px) {
            .macos-app-container {
                grid-template-columns: 200px 280px 1fr;
            }
        }

        @media (max-width: 768px) {
            body {
                height: 100dvh;
                overflow: hidden;
            }
            .macos-app-container {
                grid-template-columns: 1fr;
                height: calc(100dvh - 56px);
            }
            .sidebar-col,
            .macos-sidebar-nav {
                display: none !important;
            }
            .macos-contacts-panel.mobile-hidden {
                display: none !important;
            }
            .macos-chat-workspace.mobile-hidden {
                display: none !important;
            }
            .back-mobile-button {
                display: inline-flex !important;
            }
            .mobile-back-dash {
                display: inline-flex !important;
            }
            .macos-messages-stream {
                padding: 1rem 0.75rem !important;
                gap: 8px !important;
            }
            .imessage-wrapper {
                max-width: 86% !important;
            }
            .imessage-bubble {
                font-size: 0.88rem !important;
                padding: 9px 13px !important;
                border-radius: 16px !important;
            }
            .macos-input-bar {
                padding: 8px 10px calc(8px + env(safe-area-inset-bottom, 0px)) 10px !important;
            }
            .imessage-input-capsule {
                padding: 3px 6px 3px 14px !important;
            }
            .imessage-text-input {
                font-size: 0.9rem !important;
            }
        }
    </style>
</head>
<body>
    <UserNavbar />

    <!-- Edge-to-Edge macOS Apple Messenger Layout -->
    <div class="macos-app-container">
        <!-- 1. Left macOS Sidebar (Mentok Full) -->
        <div class="sidebar-col">
            <UserSidebar activeTab="pesan" />
        </div>

        <!-- 2. Middle Contacts Panel (iTunes / iMessage List) -->
        <section class="macos-contacts-panel" id="contactsPanel">
            <div class="macos-search-header">
                <div class="panel-header-title">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <a href="/dashboard_user" class="mobile-back-dash">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                            <span>Dashboard</span>
                        </a>
                        <h3>Pesan Masuk</h3>
                    </div>
                    <span id="unreadTotalBadge" class="apple-unread-dot" style="display: none;">0</span>
                </div>
                <div class="apple-search-wrapper">
                    <svg class="apple-search-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" id="searchContactInput" class="apple-search-input" placeholder="Cari percakapan..." oninput="filterContacts()">
                </div>
            </div>
            <!-- Quick Start Chat Button -->
            <div style="padding: 8px 12px; border-bottom: 1px solid var(--apple-border); background: #ffffff;">
                <button type="button" onclick="startNewCsChat()" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; background: var(--apple-blue); color: #ffffff; border: none; border-radius: 18px; padding: 7px 12px; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: background 0.15s;">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    <span>+ Chat Customer Support</span>
                </button>
            </div>
            <div class="macos-contacts-scroll" id="contactsList">
                <div style="padding: 3rem 1rem; text-align: center; color: var(--apple-text-muted); font-size: 0.85rem;">Memuat daftar percakapan...</div>
            </div>
        </section>

        <!-- 3. Right Chat Workspace (Apple iMessage Canvas) -->
        <main class="macos-chat-workspace mobile-hidden" id="chatMain">
            <div class="apple-empty-chat">
                <div class="apple-empty-icon">💬</div>
                <h3 style="color: var(--apple-text-main); font-weight: 700; letter-spacing: -0.3px;">Pusat Pesan EasyMall</h3>
                <p style="font-size: 0.88rem; max-width: 320px; color: var(--apple-text-secondary);">Pilih kontak di sebelah kiri untuk berkirim pesan dengan Customer Support atau Reseller.</p>
            </div>
        </main>
    </div>

    <script is:inline>
        let activeContactEmail = null;
        let messagesList = [];
        let rawContactsList = [];
        let pollingInterval = null;
        let activeUserEmail = 'user@easymall.me';

        async function initChatSystem() {
            try {
                const authRes = await fetch('/api/auth/status', {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache' }
                });
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (authData.logged_in && authData.email) {
                        activeUserEmail = authData.email;
                    }
                }
            } catch (err) {}

            await loadContactsList();

            const params = new URLSearchParams(window.location.search);
            const chatParam = params.get('chat');
            if (chatParam) {
                const target = chatParam.toLowerCase().trim();
                activeContactEmail = target;
                await openChat(target);
            } else {
                if (window.innerWidth > 768) {
                    document.getElementById('chatMain')?.classList.remove('mobile-hidden');
                }
            }

            if (pollingInterval) clearInterval(pollingInterval);
            pollingInterval = setInterval(async () => {
                await loadContactsList(false);
                if (activeContactEmail) {
                    await fetchChatHistory(activeContactEmail, false);
                }
            }, 2000);
        }

        async function loadContactsList(shouldRender = true) {
            try {
                const res = await fetch('/api/messages/contacts', { credentials: 'include' });
                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        rawContactsList = data.contacts || [];
                        if (shouldRender) renderContactsList();
                        
                        const totalUnread = rawContactsList.reduce((acc, c) => acc + (c.unread_count || 0), 0);
                        const badgeEl = document.getElementById('unreadTotalBadge');
                        const sidebarBadge = document.getElementById('sidebar-pesan-unread');
                        
                        if (badgeEl) {
                            badgeEl.innerText = totalUnread;
                            badgeEl.style.display = totalUnread > 0 ? 'inline-block' : 'none';
                        }
                        if (sidebarBadge) {
                            sidebarBadge.innerText = totalUnread;
                            sidebarBadge.style.display = totalUnread > 0 ? 'inline-block' : 'none';
                        }
                    }
                }
            } catch (err) {}
        }

        function startNewCsChat() {
            openChat('admin@easymall.me');
        }

        function filterContacts() {
            renderContactsList();
        }

        function renderContactsList() {
            const listEl = document.getElementById('contactsList');
            const searchVal = (document.getElementById('searchContactInput')?.value || '').toLowerCase().trim();
            if (!listEl) return;

            const filtered = rawContactsList.filter(c => 
                (c.contact_name || '').toLowerCase().includes(searchVal) ||
                (c.contact_email || '').toLowerCase().includes(searchVal)
            );

            if (filtered.length === 0) {
                listEl.innerHTML = `
                    <div style="padding: 2.5rem 1rem; text-align: center; color: var(--apple-text-muted); font-size: 0.85rem; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="font-size: 2rem;">💬</div>
                        <div style="font-weight: 700; color: var(--apple-text-main);">Belum ada percakapan</div>
                        <p style="font-size: 0.8rem; margin: 0; color: var(--apple-text-secondary); max-width: 200px;">Ada pertanyaan seputar produk atau pesanan Anda?</p>
                        <button onclick="startNewCsChat()" style="margin-top: 6px; background: var(--apple-blue); color: #ffffff; border: none; padding: 7px 14px; border-radius: 16px; font-weight: 600; font-size: 0.8rem; cursor: pointer;">Chat CS Sekarang</button>
                    </div>
                `;
                return;
            }

            listEl.innerHTML = filtered.map(c => {
                const isActive = c.contact_email === activeContactEmail ? 'active' : '';
                const initial = (c.contact_name || '?').charAt(0).toUpperCase();
                const unreadBadge = (c.unread_count > 0) ? `<span class="apple-unread-dot">${c.unread_count}</span>` : '';

                return `
                    <div class="apple-contact-card ${isActive}" onclick="openChat('${c.contact_email}')">
                        <div class="apple-avatar-wrap">
                            <div class="apple-avatar">${initial}</div>
                            <span class="apple-online-indicator"></span>
                        </div>
                        <div class="apple-contact-content">
                            <div class="contact-top-row">
                                <span class="apple-contact-name">${c.contact_name || c.contact_email}</span>
                                <span class="apple-contact-time">${c.last_message_time || ''}</span>
                            </div>
                            <div class="contact-bottom-row">
                                <span class="apple-last-snippet">${c.last_message || ''}</span>
                                ${unreadBadge}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function openChat(contactEmail) {
            activeContactEmail = contactEmail;
            renderContactsList();

            if (window.innerWidth <= 768) {
                document.getElementById('contactsPanel')?.classList.add('mobile-hidden');
                document.getElementById('chatMain')?.classList.remove('mobile-hidden');
            } else {
                document.getElementById('chatMain')?.classList.remove('mobile-hidden');
            }

            const chatMain = document.getElementById('chatMain');
            const contact = rawContactsList.find(c => c.contact_email === contactEmail);
            const contactName = contact ? contact.contact_name : contactEmail.split('@')[0];

            chatMain.innerHTML = `
                <header class="macos-chat-header">
                    <div class="active-user-meta">
                        <button class="back-mobile-button" onclick="backToContacts()" aria-label="Kembali">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                            <span>Pesan</span>
                        </button>
                        <div class="apple-avatar" style="width: 36px; height: 36px; font-size: 0.95rem;">${contactName.charAt(0).toUpperCase()}</div>
                        <div>
                            <div class="active-user-name">${contactName}</div>
                            <div class="active-user-status">● Online</div>
                        </div>
                    </div>
                    <div>
                        <span class="telegram-badge-tag" style="background: rgba(52, 199, 89, 0.1); color: #34c759; cursor: default;">
                            <span style="font-size: 0.65rem;">●</span>
                            <span>Live Support Aktif</span>
                        </span>
                    </div>
                </header>
                <div class="macos-messages-stream" id="chatBody">
                    <div style="padding: 3rem; text-align: center; color: var(--apple-text-muted); font-size: 0.88rem;">Memuat percakapan...</div>
                </div>
                <footer class="macos-input-bar">
                    <div class="imessage-input-capsule">
                        <input type="text" id="messageInput" class="imessage-text-input" placeholder="iMessage..." onkeydown="handleInputKeyDown(event)">
                        <button type="button" class="imessage-send-arrow" id="sendBtn" onclick="handleSendMessage()" aria-label="Kirim">
                            <svg width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm-1.05-1.12L1.587 6.185l11.554-4.622z"/></svg>
                        </button>
                    </div>
                </footer>
            `;

            await fetchChatHistory(contactEmail, true);
        }

        function backToContacts() {
            activeContactEmail = null;
            document.getElementById('contactsPanel')?.classList.remove('mobile-hidden');
            document.getElementById('chatMain')?.classList.add('mobile-hidden');
            renderContactsList();
        }

        async function fetchChatHistory(email, shouldScroll = false) {
            try {
                const res = await fetch(`/api/messages/chat?with_email=${encodeURIComponent(email)}`, { credentials: 'include' });
                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        messagesList = data.messages || [];
                        renderChatMessages(shouldScroll);
                    }
                }
            } catch (err) {}
        }

        function renderChatMessages(shouldScroll = false) {
            const chatBody = document.getElementById('chatBody');
            if (!chatBody) return;

            if (messagesList.length === 0) {
                chatBody.innerHTML = `
                    <div style="padding: 4rem 1rem; text-align: center; color: var(--apple-text-secondary); font-size: 0.88rem;">
                        👋 Belum ada pesan dengan kontak ini.<br>Kirim pesan pertama Anda untuk memulai obrolan!
                    </div>
                `;
                return;
            }

            chatBody.innerHTML = messagesList.map(m => {
                const isSent = m.sender_email === activeUserEmail;
                const alignmentClass = isSent ? 'sent' : 'received';
                const timeStr = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
                const senderName = isSent ? 'Anda' : (m.sender_name || m.sender_email);

                return `
                    <div class="imessage-wrapper ${alignmentClass}">
                        <span class="imessage-sender-tag">${senderName}</span>
                        <div class="imessage-bubble">${escapeHtml(m.message)}</div>
                        <span class="imessage-meta">
                            <span>${timeStr}</span>
                            ${isSent ? '<span style="color: #007aff; font-weight: 700;">✓✓</span>' : ''}
                        </span>
                    </div>
                `;
            }).join('');

            if (shouldScroll) {
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        }

        async function handleSendMessage() {
            const input = document.getElementById('messageInput');
            const sendBtn = document.getElementById('sendBtn');
            if (!input || !input.value.trim() || !activeContactEmail) return;

            const text = input.value.trim();
            input.value = '';
            input.disabled = true;
            if (sendBtn) sendBtn.disabled = true;

            try {
                const res = await fetch('/api/messages/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        receiver_email: activeContactEmail,
                        message: text
                    }),
                    credentials: 'include'
                });

                if (res.ok) {
                    await fetchChatHistory(activeContactEmail, true);
                    await loadContactsList(true);
                }
            } catch (err) {
            } finally {
                input.disabled = false;
                if (sendBtn) sendBtn.disabled = false;
                input.focus();
            }
        }

        function handleInputKeyDown(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                handleSendMessage();
            }
        }

        function escapeHtml(str) {
            return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        async function performLogout() {
            try {
                await fetch('/logout', { credentials: 'include' });
            } catch(e){}
            window.location.href = '/login';
        }

        initChatSystem();
    </script>
</body>
</html>
