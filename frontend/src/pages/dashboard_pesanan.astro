---
// dashboard_pesanan.astro
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesanan Saya | EasyMall</title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <style>
        :root {
            --bg-color: #f8f9fa;
            --text-color: #212529;
            --border-color: #dee2e6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        .container {
            max-width: 1140px;
            width: 100%;
            margin: 1.5rem auto;
            padding: 0 1rem;
            flex-grow: 1;
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 1.5rem;
        }

        .sidebar-col {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .content-area {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
        }

        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden;
                width: 100%;
            }
            body {
                padding-bottom: 74px !important;
            }
            .container {
                grid-template-columns: 1fr;
                padding: 0 0.75rem;
                margin: 1rem auto;
            }
            .content-area {
                min-width: 0;
                width: 100%;
            }
        }

        .card {
            background: #ffffff;
            border: 2px solid #dee2e6;
            border-radius: 4px;
            overflow: hidden;
        }

        .card-header {
            background: #f8f9fa;
            padding: 0.75rem 1.25rem;
            border-bottom: 2px solid #dee2e6;
            font-weight: bold;
            font-size: 1rem;
            color: #212529;
        }

        .card-body {
            padding: 1.25rem;
        }

        /* Filter Controls */
        .filter-group {
            display: flex;
            gap: 10px;
            margin-bottom: 1.25rem;
        }

        .filter-input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            outline: none;
            font-size: 0.9rem;
        }

        .filter-input:focus {
            border-color: #80bdff;
        }

        .btn-filter {
            padding: 8px 16px;
            background: #007bff;
            color: white;
            border: 1px solid #007bff;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-filter:hover {
            background: #0069d9;
        }

        /* Table Responsive Styles */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 6px;
            margin-bottom: 0.5rem;
        }

        .table-responsive::-webkit-scrollbar {
            height: 6px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .scroll-hint {
            display: none;
            font-size: 0.8rem;
            color: #64748b;
            margin-bottom: 0.5rem;
            align-items: center;
            gap: 4px;
        }

        @media (max-width: 768px) {
            .scroll-hint {
                display: flex;
            }
        }

        table {
            min-width: 650px;
            width: 100%;
            border-collapse: collapse;
            background-color: #ffffff;
        }

        th, td {
            padding: 12px 14px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.88rem;
            vertical-align: middle;
        }

        th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid var(--border-color);
            white-space: nowrap;
        }

        tr.order-row {
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        tr.order-row:hover td {
            background-color: #f1f5f9;
        }

        code {
            font-family: monospace;
            font-size: 0.85rem;
            background-color: #e9ecef;
            padding: 2px 4px;
            border-radius: 3px;
            color: #212529;
        }

        .no-data {
            padding: 3rem;
            text-align: center;
            color: #6c757d;
        }

        .loading-spinner {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            color: #007bff;
            gap: 10px;
            font-size: 0.9rem;
        }

        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(0, 123, 255, 0.1);
            border-top-color: #007bff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Order Detail Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 1050;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            box-sizing: border-box;
        }

        .modal-backdrop.active {
            display: flex;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 12px;
            max-width: 520px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            animation: modalSlideUp 0.25s ease-out;
            display: flex;
            flex-direction: column;
        }

        @keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.97);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8fafc;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
        }

        .modal-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-close-modal {
            background: none;
            border: none;
            font-size: 1.4rem;
            color: #64748b;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
        }

        .btn-close-modal:hover {
            color: #0f172a;
        }

        .modal-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            font-size: 0.9rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 6px 0;
            border-bottom: 1px dashed #f1f5f9;
        }

        .detail-label {
            color: #64748b;
            font-weight: 500;
        }

        .detail-value {
            color: #0f172a;
            font-weight: 600;
            text-align: right;
            max-width: 60%;
            word-break: break-word;
        }

        .credentials-box {
            background: #f0fdf4;
            border: 1px solid #86efac;
            border-radius: 8px;
            padding: 12px;
        }

        .credentials-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            font-weight: 700;
            color: #166534;
            font-size: 0.85rem;
        }

        .btn-copy-creds {
            background: #16a34a;
            color: white;
            border: none;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .btn-copy-creds:hover {
            background: #15803d;
        }

        .credentials-content {
            background: #ffffff;
            border: 1px solid #bbf7d0;
            border-radius: 6px;
            padding: 8px 10px;
            font-family: monospace;
            font-size: 0.88rem;
            white-space: pre-wrap;
            word-break: break-all;
            color: #14532d;
        }

        .qris-modal-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 8px;
            padding: 14px;
            text-align: center;
        }

        .qris-modal-img {
            max-width: 220px;
            width: 100%;
            height: auto;
            border-radius: 8px;
            border: 2px solid #fef3c7;
            margin: 8px auto;
            display: block;
            background: white;
            padding: 6px;
        }

        .btn-check-live {
            width: 100%;
            padding: 8px 14px;
            background: #0284c7;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-check-live:hover {
            background: #0369a1;
        }

        .btn-detail-sm {
            padding: 4px 10px;
            background: #0284c7;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-detail-sm:hover {
            background: #0369a1;
        }

    </style>
</head>
<body>
    <UserNavbar />

    <div class="container">
        <div class="sidebar-col">
            <UserSidebar activeTab="pesanan" />
        </div>

        <div class="content-area">
            <div class="card">
                <div class="card-header">📦 Riwayat Pesanan Saya</div>
                <div class="card-body">
                    <div class="filter-group">
                        <input type="text" id="searchOrderInput" class="filter-input" placeholder="Cari berdasarkan nama produk atau ID transaksi...">
                        <button class="btn-filter" onclick="searchOrders()">Cari</button>
                    </div>

                    <div id="table-container">
                        <div class="loading-spinner">
                            <div class="spinner"></div>
                            Memuat pesanan...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Detail Modal -->
    <div id="orderDetailModal" class="modal-backdrop" onclick="handleBackdropClick(event)">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title">
                    <span>📦 Detail Pesanan</span>
                </div>
                <button type="button" class="btn-close-modal" onclick="closeOrderDetail()">&times;</button>
            </div>
            <div class="modal-body" id="modalDetailContent">
                <!-- Populated dynamically via JS -->
            </div>
        </div>
    </div>

    <script is:inline>
        let API_BASE_URL = '';
        if (window.location.port !== '5002' && window.location.protocol !== 'file:') {
            API_BASE_URL = '';
        }

        let ordersData = [];

        function formatRupiah(num) {
            if (num === null || num === undefined) return "Rp 0";
            return "Rp " + parseInt(num, 10).toLocaleString('id-ID');
        }

        async function fetchUserData() {
            let currentUserEmail = '';
            try {
                const authRes = await fetch(`${API_BASE_URL}/api/auth/status`, {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache' }
                });
                
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (authData.logged_in) {
                        currentUserEmail = (authData.email || '').toLowerCase();
                        const nameEl = document.getElementById('user-name');
                        const emailEl = document.getElementById('user-email');
                        const avatarEl = document.getElementById('avatar-initial');
                        if (nameEl) nameEl.textContent = authData.name;
                        if (emailEl) emailEl.textContent = authData.email;
                        if (avatarEl) avatarEl.textContent = (authData.name || 'U').charAt(0).toUpperCase();
                    } else {
                        const cookies = document.cookie || '';
                        if (!cookies.includes('session_id=') && !cookies.includes('em_session_data=')) {
                            window.location.replace('/login');
                            return;
                        }
                    }
                }
            } catch (err) {
                console.warn('Network issue fetching auth status in dashboard_pesanan:', err);
            }

            try {
                // Read local cached orders
                let localOrders = [];
                try {
                    localOrders = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                } catch (e) {}

                const dataRes = await fetch(`${API_BASE_URL}/api/dashboard/data`, { credentials: 'include' });
                let serverOrders = [];
                if (dataRes.ok) {
                    const res = await dataRes.json();
                    if (res.success && Array.isArray(res.transactions)) {
                        serverOrders = res.transactions;
                    }
                }

                // Merge server and local orders, prioritizing latest status and deduplicating by transaction_id
                const orderMap = new Map();
                // Add local orders first
                localOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        orderMap.set(o.transaction_id, o);
                    }
                });
                // Overwrite / merge with server orders
                serverOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        const existing = orderMap.get(o.transaction_id) || {};
                        orderMap.set(o.transaction_id, { ...existing, ...o });
                    }
                });

                ordersData = Array.from(orderMap.values());
                
                // Sort newest first
                ordersData.sort((a, b) => {
                    const dateA = new Date(a.created_at || 0).getTime();
                    const dateB = new Date(b.created_at || 0).getTime();
                    return dateB - dateA;
                });

                renderOrders(ordersData);
            } catch (err) {
                console.error('Error fetching dashboard orders:', err);
                try {
                    ordersData = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                    renderOrders(ordersData);
                } catch (e) {
                    showNoData();
                }
            }
        }

        function renderStatusBadge(status) {
            const st = (status || 'pending').toLowerCase();
            if (st === 'paid' || st === 'success') {
                return '<span style="background: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem; display: inline-block;">✅ Lunas / Berhasil</span>';
            } else if (st === 'failed' || st === 'cancelled') {
                return '<span style="background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem; display: inline-block;">❌ Gagal</span>';
            } else {
                return '<span style="background: #fff3cd; color: #856404; border: 1px solid #ffeeba; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem; display: inline-block;">⏳ Menunggu Pembayaran</span>';
            }
        }

        function renderOrders(list) {
            const container = document.getElementById('table-container');
            if (list.length === 0) {
                container.innerHTML = '<div class="no-data">Belum ada pesanan ditemukan.</div>';
                return;
            }

            container.innerHTML = `
                <div class="scroll-hint">👉 Geser tabel ke kanan/kiri untuk melihat detail lengkap</div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>ID Transaksi</th>
                                <th>Nama Produk</th>
                                <th>Varian</th>
                                <th>Total Bayar</th>
                                <th>Status</th>
                                <th>Data Akun / SN</th>
                                <th>Tanggal</th>
                                <th style="text-align: center;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${list.map(o => {
                                const creds = o.stock_data || o.sn || o.link || '';
                                return `
                                <tr class="order-row" onclick="openOrderDetail('${o.transaction_id}')">
                                    <td><code>${o.transaction_id}</code></td>
                                    <td><b>${o.product_name || '-'}</b></td>
                                    <td>${o.variant_name || '-'}</td>
                                    <td><span style="color: #28a745; font-weight: bold;">${formatRupiah(o.amount)}</span></td>
                                    <td>${renderStatusBadge(o.status)}</td>
                                    <td>
                                        ${creds ? `
                                            <span style="background: #e6fcf5; color: #0ca678; border: 1px solid #b2f2bb; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 0.75rem;">🔑 Tersedia</span>
                                        ` : `<span style="color: #94a3b8; font-size: 0.8rem;">-</span>`}
                                    </td>
                                    <td><small style="color: #6c757d; white-space: nowrap;">${o.created_at || '-'}</small></td>
                                    <td style="text-align: center;" onclick="event.stopPropagation();">
                                        <button type="button" class="btn-detail-sm" onclick="openOrderDetail('${o.transaction_id}')">🔍 Detail</button>
                                    </td>
                                </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        }

        function openOrderDetail(trxId) {
            const order = ordersData.find(o => o.transaction_id === trxId);
            if (!order) return;

            const modal = document.getElementById('orderDetailModal');
            const content = document.getElementById('modalDetailContent');
            const creds = order.stock_data || order.sn || order.link || '';
            const isPending = (order.status || 'pending').toLowerCase() === 'pending';

            content.innerHTML = `
                <div class="detail-row">
                    <span class="detail-label">ID Transaksi:</span>
                    <span class="detail-value"><code>${order.transaction_id}</code></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Nama Produk:</span>
                    <span class="detail-value">${order.product_name || '-'}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Varian:</span>
                    <span class="detail-value">${order.variant_name || '-'}</span>
                </div>
                ${order.target ? `
                <div class="detail-row">
                    <span class="detail-label">Tujuan / Kontak:</span>
                    <span class="detail-value">${order.target}</span>
                </div>
                ` : ''}
                <div class="detail-row">
                    <span class="detail-label">Total Pembayaran:</span>
                    <span class="detail-value" style="color: #28a745; font-size: 1.05rem;">${formatRupiah(order.amount)}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status Pesanan:</span>
                    <span class="detail-value" id="modalStatusBadge">${renderStatusBadge(order.status)}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Tanggal Pembuatan:</span>
                    <span class="detail-value">${order.created_at || '-'}</span>
                </div>

                ${creds ? `
                <div class="credentials-box">
                    <div class="credentials-header">
                        <span>🔑 DATA AKUN / VOUCHER / SERIAL NUMBER</span>
                        <button type="button" class="btn-copy-creds" onclick="copyCredentials('${encodeURIComponent(creds)}')">📋 Salin Data</button>
                    </div>
                    <div class="credentials-content">${creds}</div>
                </div>
                ` : ''}

                ${isPending ? `
                <div class="qris-modal-box">
                    <b style="color: #92400e; font-size: 0.9rem;">⏳ Menunggu Pembayaran QRIS</b>
                    ${order.qr_image_url ? `
                        <img src="${order.qr_image_url}" alt="QRIS" class="qris-modal-img" />
                    ` : ''}
                    <button type="button" class="btn-check-live" id="btnLiveCheck" onclick="checkLiveStatus('${order.transaction_id}')">
                        🔄 Cek Status Pembayaran Real-Time
                    </button>
                </div>
                ` : ''}
            `;

            modal.classList.add('active');
        }

        async function checkLiveStatus(trxId) {
            const btn = document.getElementById('btnLiveCheck');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '🔄 Memeriksa...';
            }

            try {
                const res = await fetch(`${API_BASE_URL}/api/order/status/${trxId}`);
                const data = await res.json();
                if (res.ok && data.success) {
                    if (data.status === 'paid' || data.status === 'success') {
                        // Update in memory & storage
                        const updated = ordersData.map(o => {
                            if (o.transaction_id === trxId) {
                                return {
                                    ...o,
                                    status: 'paid',
                                    stock_data: data.stock_data || o.stock_data,
                                    sn: data.sn || o.sn,
                                    link: data.link || o.link
                                };
                            }
                            return o;
                        });
                        ordersData = updated;
                        localStorage.setItem('easymall_orders', JSON.stringify(ordersData));
                        renderOrders(ordersData);
                        openOrderDetail(trxId);
                        alert('🎉 Pembayaran terverifikasi! Pesanan Anda telah lunas.');
                    } else if (data.status === 'failed') {
                        alert('❌ Transaksi gagal atau dibatalkan.');
                    } else {
                        alert('⏳ Pembayaran belum terdeteksi. Silakan scan dan selesaikan QRIS terlebih dahulu.');
                    }
                } else {
                    alert('Gagal memeriksa status pembayaran.');
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan jaringan.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '🔄 Cek Status Pembayaran Real-Time';
                }
            }
        }

        function copyCredentials(encodedCreds) {
            try {
                const text = decodeURIComponent(encodedCreds);
                navigator.clipboard.writeText(text);
                alert('✅ Data akun/voucher berhasil disalin ke clipboard!');
            } catch (e) {
                alert('Gagal menyalin teks.');
            }
        }

        function closeOrderDetail() {
            const modal = document.getElementById('orderDetailModal');
            if (modal) modal.classList.remove('active');
        }

        function handleBackdropClick(e) {
            if (e.target.id === 'orderDetailModal') {
                closeOrderDetail();
            }
        }

        function searchOrders() {
            const query = document.getElementById('searchOrderInput').value.trim().toLowerCase();
            if (!query) {
                renderOrders(ordersData);
                return;
            }

            const filtered = ordersData.filter(o => 
                (o.transaction_id && o.transaction_id.toLowerCase().includes(query)) ||
                (o.product_name && o.product_name.toLowerCase().includes(query)) ||
                (o.variant_name && o.variant_name.toLowerCase().includes(query))
            );
            renderOrders(filtered);
        }

        function showNoData() {
            document.getElementById('table-container').innerHTML = '<div class="no-data">Gagal memuat daftar pesanan.</div>';
        }

        async function performLogout() {
            try {
                await fetch(`${API_BASE_URL}/logout`, { credentials: 'include' });
            } catch(e){}
            window.location.href = '/login';
        }

        fetchUserData();
    </script>
    <BottomNav />
</body>
</html>
