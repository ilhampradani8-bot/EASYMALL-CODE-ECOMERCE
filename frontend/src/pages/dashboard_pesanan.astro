---
// dashboard_pesanan.astro
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesanan Saya | EasyMall</title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <style>
        :root {
            --bg-color: #f8f9fa;
            --text-color: #212529;
            --border-color: #dee2e6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        .container {
            max-width: 1140px;
            width: 100%;
            margin: 1.5rem auto;
            padding: 0 1rem;
            flex-grow: 1;
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 1.5rem;
        }

        .sidebar-col {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .content-area {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
        }

        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden;
                width: 100%;
            }
            body {
                padding-bottom: 74px !important;
            }
            .container {
                grid-template-columns: 1fr;
                padding: 0 0.75rem;
                margin: 1rem auto;
            }
            .content-area {
                min-width: 0;
                width: 100%;
            }
        }

        .card {
            background: #ffffff;
            border: 2px solid #dee2e6;
            border-radius: 4px;
            overflow: hidden;
        }

        .card-header {
            background: #f8f9fa;
            padding: 0.75rem 1.25rem;
            border-bottom: 2px solid #dee2e6;
            font-weight: bold;
            font-size: 1rem;
            color: #212529;
        }

        .card-body {
            padding: 1.25rem;
        }

        /* Filter Controls */
        .filter-group {
            display: flex;
            gap: 10px;
            margin-bottom: 1.25rem;
        }

        .filter-input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            outline: none;
            font-size: 0.9rem;
        }

        .filter-input:focus {
            border-color: #80bdff;
        }

        .btn-filter {
            padding: 8px 16px;
            background: #007bff;
            color: white;
            border: 1px solid #007bff;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-filter:hover {
            background: #0069d9;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #ffffff;
        }

        th, td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
        }

        th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid var(--border-color);
        }

        tr:hover td {
            background-color: #f1f3f5;
        }

        code {
            font-family: monospace;
            font-size: 0.85rem;
            background-color: #e9ecef;
            padding: 2px 4px;
            border-radius: 3px;
            color: #212529;
        }

        .no-data {
            padding: 3rem;
            text-align: center;
            color: #6c757d;
        }

        .loading-spinner {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            color: #007bff;
            gap: 10px;
            font-size: 0.9rem;
        }

        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(0, 123, 255, 0.1);
            border-top-color: #007bff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

    </style>
</head>
<body>
    <UserNavbar />

    <div class="container">
        <div class="sidebar-col">
            <UserSidebar activeTab="pesanan" />
        </div>

        <div class="content-area">
            <div class="card">
                <div class="card-header">📦 Riwayat Pesanan Saya</div>
                <div class="card-body">
                    <div class="filter-group">
                        <input type="text" id="searchOrderInput" class="filter-input" placeholder="Cari berdasarkan nama produk atau ID transaksi...">
                        <button class="btn-filter" onclick="searchOrders()">Cari</button>
                    </div>

                    <div id="table-container">
                        <div class="loading-spinner">
                            <div class="spinner"></div>
                            Memuat pesanan...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        let API_BASE_URL = '';
        if (window.location.port !== '5002' && window.location.protocol !== 'file:') {
            API_BASE_URL = '';
        }

        let ordersData = [];

        function formatRupiah(num) {
            if (num === null || num === undefined) return "Rp 0";
            return "Rp " + parseInt(num, 10).toLocaleString('id-ID');
        }

        async function fetchUserData() {
            let currentUserEmail = '';
            try {
                const authRes = await fetch(`${API_BASE_URL}/api/auth/status`, {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache' }
                });
                
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (authData.logged_in) {
                        currentUserEmail = (authData.email || '').toLowerCase();
                        const nameEl = document.getElementById('user-name');
                        const emailEl = document.getElementById('user-email');
                        const avatarEl = document.getElementById('avatar-initial');
                        if (nameEl) nameEl.textContent = authData.name;
                        if (emailEl) emailEl.textContent = authData.email;
                        if (avatarEl) avatarEl.textContent = (authData.name || 'U').charAt(0).toUpperCase();
                    } else {
                        const cookies = document.cookie || '';
                        if (!cookies.includes('session_id=') && !cookies.includes('em_session_data=')) {
                            window.location.replace('/login');
                            return;
                        }
                    }
                }
            } catch (err) {
                console.warn('Network issue fetching auth status in dashboard_pesanan:', err);
            }

            try {
                // Read local cached orders
                let localOrders = [];
                try {
                    localOrders = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                } catch (e) {}

                const dataRes = await fetch(`${API_BASE_URL}/api/dashboard/data`, { credentials: 'include' });
                let serverOrders = [];
                if (dataRes.ok) {
                    const res = await dataRes.json();
                    if (res.success && Array.isArray(res.transactions)) {
                        serverOrders = res.transactions;
                    }
                }

                // Merge server and local orders, prioritizing latest status and deduplicating by transaction_id
                const orderMap = new Map();
                // Add local orders first
                localOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        orderMap.set(o.transaction_id, o);
                    }
                });
                // Overwrite / merge with server orders
                serverOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        const existing = orderMap.get(o.transaction_id) || {};
                        orderMap.set(o.transaction_id, { ...existing, ...o });
                    }
                });

                ordersData = Array.from(orderMap.values());
                
                // Sort newest first
                ordersData.sort((a, b) => {
                    const dateA = new Date(a.created_at || 0).getTime();
                    const dateB = new Date(b.created_at || 0).getTime();
                    return dateB - dateA;
                });

                renderOrders(ordersData);
            } catch (err) {
                console.error('Error fetching dashboard orders:', err);
                // Fallback to local orders
                try {
                    ordersData = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                    renderOrders(ordersData);
                } catch (e) {
                    showNoData();
                }
            }
        }

        function renderStatusBadge(status) {
            const st = (status || 'pending').toLowerCase();
            if (st === 'paid' || st === 'success') {
                return '<span style="background: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem; display: inline-block;">✅ Lunas / Berhasil</span>';
            } else if (st === 'failed' || st === 'cancelled') {
                return '<span style="background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem; display: inline-block;">❌ Gagal</span>';
            } else {
                return '<span style="background: #fff3cd; color: #856404; border: 1px solid #ffeeba; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem; display: inline-block;">⏳ Menunggu Pembayaran</span>';
            }
        }

        function renderOrders(list) {
            const container = document.getElementById('table-container');
            if (list.length === 0) {
                container.innerHTML = '<div class="no-data">Belum ada pesanan ditemukan.</div>';
                return;
            }

            container.innerHTML = `
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th>ID Transaksi</th>
                            <th>Nama Produk</th>
                            <th>Varian</th>
                            <th>Total Bayar</th>
                            <th>Status & Data Akun / SN</th>
                            <th>Tanggal</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${list.map(o => {
                            const creds = o.stock_data || o.sn || o.link || '';
                            return `
                            <tr>
                                <td><code>${o.transaction_id}</code></td>
                                <td><b>${o.product_name || '-'}</b></td>
                                <td>${o.variant_name || '-'}</td>
                                <td><span style="color: #28a745; font-weight: bold;">${formatRupiah(o.amount)}</span></td>
                                <td>
                                    ${renderStatusBadge(o.status)}
                                    ${creds ? `
                                        <div style="margin-top: 6px; background: #f8f9fa; border: 1px dashed #28a745; padding: 6px 8px; border-radius: 4px; font-size: 0.8rem;">
                                            <div style="font-weight: bold; color: #155724; margin-bottom: 2px;">🔑 Data Akun / SN:</div>
                                            <code style="word-break: break-all; white-space: pre-wrap; font-size: 0.8rem; background: #fff; padding: 2px 4px; display: block; border-radius: 2px;">${creds}</code>
                                        </div>
                                    ` : ''}
                                </td>
                                <td><small style="color: #6c757d;">${o.created_at || '-'}</small></td>
                            </tr>
                            `;
                        }).join('')}
                    </tbody>
                </table>
            `;
        }

        function searchOrders() {
            const query = document.getElementById('searchOrderInput').value.trim().toLowerCase();
            if (!query) {
                renderOrders(ordersData);
                return;
            }

            const filtered = ordersData.filter(o => 
                (o.transaction_id && o.transaction_id.toLowerCase().includes(query)) ||
                (o.product_name && o.product_name.toLowerCase().includes(query)) ||
                (o.variant_name && o.variant_name.toLowerCase().includes(query))
            );
            renderOrders(filtered);
        }

        function showNoData() {
            document.getElementById('table-container').innerHTML = '<div class="no-data">Gagal memuat daftar pesanan.</div>';
        }

        async function performLogout() {
            try {
                await fetch(`${API_BASE_URL}/logout`, { credentials: 'include' });
            } catch(e){}
            window.location.href = '/login';
        }

        fetchUserData();
    </script>
    <BottomNav />
</body>
</html>
