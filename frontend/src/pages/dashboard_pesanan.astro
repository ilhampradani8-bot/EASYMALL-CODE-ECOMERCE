---
// dashboard_pesanan.astro
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesanan Saya | EasyMall</title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <style is:global>
        :root {
            --bg-color: #f5f5f7;
            --text-color: #1d1d1f;
            --border-color: rgba(0, 0, 0, 0.08);
            --apple-blue: #007aff;
            --apple-card-bg: #ffffff;
            --font-apple: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-apple);
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        /* Fullwidth macOS Desktop Layout */
        .container {
            max-width: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            flex-grow: 1;
            display: grid;
            grid-template-columns: 240px 1fr;
            min-height: calc(100vh - 62px);
            background: #f5f5f7;
        }

        .sidebar-col {
            background: #f6f8fa;
            border-right: 1px solid var(--border-color);
            padding: 1.25rem 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
        }

        .content-area {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
            padding: 1.5rem 2rem;
            overflow-y: auto;
        }

        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden;
                width: 100%;
            }
            body {
                padding-bottom: 74px !important;
            }
            .container {
                grid-template-columns: 1fr;
                min-height: auto;
            }
            .content-area {
                min-width: 0;
                width: 100%;
                padding: 1rem 0.85rem;
            }
            .sidebar-col {
                display: none !important;
            }
        }

        .card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .card-header {
            background: #fafafa;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            font-size: 1rem;
            color: #1d1d1f;
        }

        .card-body {
            padding: 1.25rem;
        }

        /* Filter Controls */
        .filter-group {
            display: flex;
            gap: 10px;
            margin-bottom: 1.25rem;
        }

        .filter-input {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid rgba(0, 0, 0, 0.12);
            border-radius: 8px;
            outline: none;
            font-size: 0.9rem;
            background: #ffffff;
            transition: all 0.2s ease;
        }

        .filter-input:focus {
            border-color: #007aff;
            box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.12);
        }

        .btn-filter {
            padding: 10px 20px;
            background: #007aff;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 2px 6px rgba(0, 122, 255, 0.2);
        }

        .btn-filter:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
        }

        /* Table Responsive Horizontal Scroll */
        .table-responsive {
            width: 100%;
            max-width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            margin-bottom: 0.5rem;
            display: block;
        }

        .table-responsive::-webkit-scrollbar {
            height: 6px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f5f5f7;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #d2d2d7;
            border-radius: 3px;
        }

        table {
            min-width: 760px;
            width: 100%;
            border-collapse: collapse;
            background-color: #ffffff;
        }

        th, td {
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.88rem;
            vertical-align: middle;
            white-space: nowrap !important;
        }

        th {
            background-color: #fbfbfd;
            font-weight: 600;
            color: #86868b;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border-color);
        }

        tr.order-row {
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        tr.order-row:hover td {
            background-color: #f8f8fa;
        }

        code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.82rem;
            background-color: #f5f5f7;
            border: 1px solid rgba(0,0,0,0.06);
            padding: 3px 6px;
            border-radius: 4px;
            color: #1d1d1f;
            white-space: nowrap;
        }

        .no-data {
            padding: 2.5rem;
            text-align: center;
            color: #86868b;
            font-size: 0.9rem;
        }

        .loading-spinner {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2.5rem 1rem;
            color: #007aff;
            gap: 8px;
            font-size: 0.88rem;
        }

        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(0, 122, 255, 0.15);
            border-top-color: #007aff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Order Detail Modal - Apple Style */
        .modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            box-sizing: border-box;
        }

        .modal-backdrop.active {
            display: flex;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            max-width: 460px;
            width: 100%;
            max-height: 88vh;
            overflow-y: auto;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            animation: modalSlideUp 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
        }

        @keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: translateY(16px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fafafa;
        }

        .modal-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1d1d1f;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-close-modal {
            background: rgba(0,0,0,0.06);
            border: none;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            font-size: 1.1rem;
            color: #86868b;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            transition: all 0.2s;
        }

        .btn-close-modal:hover {
            background: rgba(0,0,0,0.12);
            color: #1d1d1f;
        }

        .modal-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            font-size: 0.88rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 6px 0;
            border-bottom: 1px solid rgba(0,0,0,0.04);
        }

        .detail-label {
            color: #86868b;
            font-weight: 500;
            font-size: 0.85rem;
        }

        .detail-value {
            color: #1d1d1f;
            font-weight: 600;
            text-align: right;
            max-width: 65%;
            word-break: break-word;
        }

        .credentials-box {
            background: #f2fbf5;
            border: 1px solid #c7f0d6;
            border-radius: 10px;
            padding: 12px;
        }

        .credentials-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-weight: 700;
            color: #1b5e20;
            font-size: 0.82rem;
        }

        .btn-copy-creds {
            background: #34c759;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn-copy-creds:hover {
            opacity: 0.85;
        }

        .credentials-content {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 8px;
            padding: 8px 10px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.85rem;
            white-space: pre-wrap;
            word-break: break-all;
            color: #1b5e20;
            max-height: 120px;
            overflow-y: auto;
        }

        .qris-modal-box {
            background: #fffdf5;
            border: 1px solid #fce8a6;
            border-radius: 10px;
            padding: 12px;
            text-align: center;
        }

        .qris-modal-img {
            max-width: 165px;
            max-height: 165px;
            width: 100%;
            height: auto;
            border-radius: 8px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            margin: 8px auto;
            display: block;
            background: white;
            padding: 6px;
            object-fit: contain;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .btn-check-live {
            width: 100%;
            padding: 10px 14px;
            background: #007aff;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-check-live:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
        }

        .btn-detail-sm {
            padding: 5px 12px;
            background: #007aff;
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: opacity 0.2s;
        }

        .btn-detail-sm:hover {
            opacity: 0.85;
        }

    </style>
</head>
<body>
    <UserNavbar />

    <div class="container">
        <div class="sidebar-col">
            <UserSidebar activeTab="pesanan" />
        </div>

        <div class="content-area">
            <div class="card">
                <div class="card-header">📦 Riwayat Pesanan Saya</div>
                <div class="card-body">
                    <div class="filter-group">
                        <input type="text" id="searchOrderInput" class="filter-input" placeholder="Cari berdasarkan nama produk atau ID transaksi...">
                        <button class="btn-filter" onclick="searchOrders()">Cari</button>
                    </div>

                    <div id="table-container">
                        <div class="loading-spinner">
                            <div class="spinner"></div>
                            Memuat pesanan...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Detail Modal -->
    <div id="orderDetailModal" class="modal-backdrop" onclick="handleBackdropClick(event)">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title">
                    <span>📦 Detail Pesanan</span>
                </div>
                <button type="button" class="btn-close-modal" onclick="closeOrderDetail()">&times;</button>
            </div>
            <div class="modal-body" id="modalDetailContent">
                <!-- Populated dynamically via JS -->
            </div>
        </div>
    </div>

    <script is:inline>
        let API_BASE_URL = '';
        if (window.location.port !== '5002' && window.location.protocol !== 'file:') {
            API_BASE_URL = '';
        }

        let ordersData = [];

        function formatRupiah(num) {
            if (num === null || num === undefined) return "Rp 0";
            return "Rp " + parseInt(num, 10).toLocaleString('id-ID');
        }

        async function fetchUserData() {
            let currentUserEmail = '';
            const localToken = localStorage.getItem('em_session_data') || localStorage.getItem('session_id') || '';
            const authHeaders = localToken ? { 'Authorization': `Bearer ${localToken}` } : {};

            try {
                const authRes = await fetch(`${API_BASE_URL}/api/auth/status`, {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache', ...authHeaders }
                });
                
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (authData.logged_in) {
                        currentUserEmail = (authData.email || '').toLowerCase();
                        const nameEl = document.getElementById('user-name');
                        const emailEl = document.getElementById('user-email');
                        const avatarEl = document.getElementById('avatar-initial');
                        if (nameEl) nameEl.textContent = authData.name;
                        if (emailEl) emailEl.textContent = authData.email;
                        if (avatarEl) avatarEl.textContent = (authData.name || 'U').charAt(0).toUpperCase();

                        try {
                            localStorage.setItem('em_user_session', JSON.stringify({ email: authData.email, name: authData.name }));
                        } catch(e){}
                    } else {
                        const cached = localStorage.getItem('em_user_session');
                        if (cached) {
                            try {
                                const parsed = JSON.parse(cached);
                                if (parsed && parsed.email) {
                                    currentUserEmail = parsed.email;
                                    const nameEl = document.getElementById('user-name');
                                    const emailEl = document.getElementById('user-email');
                                    const avatarEl = document.getElementById('avatar-initial');
                                    if (nameEl) nameEl.textContent = parsed.name || parsed.email;
                                    if (emailEl) emailEl.textContent = parsed.email;
                                    if (avatarEl) avatarEl.textContent = (parsed.name || 'U').charAt(0).toUpperCase();
                                }
                            } catch(e){}
                        } else {
                            const cookies = document.cookie || '';
                            if (!cookies.includes('session_id=') && !cookies.includes('em_session_data=') && !localToken) {
                                window.location.replace('/login');
                                return;
                            }
                        }
                    }
                }
            } catch (err) {
                console.warn('Network issue fetching auth status in dashboard_pesanan:', err);
                const cached = localStorage.getItem('em_user_session');
                if (cached) {
                    try {
                        const parsed = JSON.parse(cached);
                        if (parsed && parsed.email) {
                            currentUserEmail = parsed.email;
                            const nameEl = document.getElementById('user-name');
                            const emailEl = document.getElementById('user-email');
                            const avatarEl = document.getElementById('avatar-initial');
                            if (nameEl) nameEl.textContent = parsed.name || parsed.email;
                            if (emailEl) emailEl.textContent = parsed.email;
                            if (avatarEl) avatarEl.textContent = (parsed.name || 'U').charAt(0).toUpperCase();
                        }
                    } catch(e){}
                }
            }

            try {
                // Read local cached orders
                let localOrders = [];
                try {
                    localOrders = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                } catch (e) {}

                const dataRes = await fetch(`${API_BASE_URL}/api/dashboard/data`, { 
                    credentials: 'include',
                    headers: authHeaders
                });
                let serverOrders = [];
                if (dataRes.ok) {
                    const res = await dataRes.json();
                    if (res.success && Array.isArray(res.transactions)) {
                        serverOrders = res.transactions;
                    }
                }

                // Merge server and local orders, prioritizing latest status and deduplicating by transaction_id
                const orderMap = new Map();
                // Add local orders first
                localOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        orderMap.set(o.transaction_id, o);
                    }
                });
                // Overwrite / merge with server orders
                serverOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        const existing = orderMap.get(o.transaction_id) || {};
                        orderMap.set(o.transaction_id, { ...existing, ...o });
                    }
                });

                ordersData = Array.from(orderMap.values());
                try {
                    localStorage.setItem('easymall_orders', JSON.stringify(ordersData));
                } catch(e){}
                
                // Sort newest first
                ordersData.sort((a, b) => {
                    const dateA = new Date(a.created_at || 0).getTime();
                    const dateB = new Date(b.created_at || 0).getTime();
                    return dateB - dateA;
                });

                renderOrders(ordersData);
            } catch (err) {
                console.error('Error fetching dashboard orders:', err);
                try {
                    ordersData = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                    renderOrders(ordersData);
                } catch (e) {
                    showNoData();
                }
            }
        }

        function renderStatusBadge(status) {
            const st = (status || 'pending').toLowerCase().trim();
            if (st === 'paid' || st === 'success' || st === 'settlement' || st === 'done' || st === 'completed') {
                return '<span style="background: #e8f9ee; color: #1e7e34; border: 1px solid rgba(52, 199, 89, 0.3); padding: 3px 10px; border-radius: 20px; font-weight: 600; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">✅ Lunas</span>';
            } else if (st.includes('expire') || st === 'kadaluwarsa') {
                return '<span style="background: #f2f2f7; color: #8e8e93; border: 1px solid rgba(0, 0, 0, 0.08); padding: 3px 10px; border-radius: 20px; font-weight: 600; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">⌛ Kadaluwarsa</span>';
            } else if (st === 'failed' || st === 'cancelled' || st === 'cancel' || st === 'refunded') {
                return '<span style="background: #ffebe9; color: #d70015; border: 1px solid rgba(255, 59, 48, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">❌ Batal</span>';
            } else if (st === 'processing') {
                return '<span style="background: #e7f1ff; color: #007aff; border: 1px solid rgba(0, 122, 255, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">⚙️ Diproses</span>';
            } else {
                return '<span style="background: #fff8e6; color: #b25e00; border: 1px solid rgba(255, 149, 0, 0.3); padding: 3px 10px; border-radius: 20px; font-weight: 600; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">⏳ Menunggu Pembayaran</span>';
            }
        }

        function renderOrders(list) {
            const container = document.getElementById('table-container');
            if (list.length === 0) {
                container.innerHTML = '<div class="no-data">Belum ada pesanan ditemukan.</div>';
                return;
            }

            container.innerHTML = `
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>ID Transaksi</th>
                                <th>Nama Produk</th>
                                <th>Varian</th>
                                <th>Total Bayar</th>
                                <th>Status</th>
                                <th>Data Akun / SN</th>
                                <th>Tanggal</th>
                                <th style="text-align: center;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${list.map(o => {
                                const creds = o.stock_data || o.sn || o.link || '';
                                return `
                                <tr class="order-row" onclick="openOrderDetail('${o.transaction_id}')">
                                    <td><code>${o.transaction_id}</code></td>
                                    <td><b>${o.product_name || '-'}</b></td>
                                    <td>${o.variant_name || '-'}</td>
                                    <td><span style="color: #28a745; font-weight: bold;">${formatRupiah(o.amount)}</span></td>
                                    <td>${renderStatusBadge(o.status)}</td>
                                    <td>
                                        ${creds ? `
                                            <span style="background: #e6fcf5; color: #0ca678; border: 1px solid #b2f2bb; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 0.75rem;">🔑 Tersedia</span>
                                        ` : `<span style="color: #94a3b8; font-size: 0.8rem;">-</span>`}
                                    </td>
                                    <td><small style="color: #6c757d; white-space: nowrap;">${o.created_at || '-'}</small></td>
                                    <td style="text-align: center;" onclick="event.stopPropagation();">
                                        <button type="button" class="btn-detail-sm" onclick="openOrderDetail('${o.transaction_id}')">🔍 Detail</button>
                                    </td>
                                </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        }

        function openOrderDetail(trxId) {
            const order = ordersData.find(o => o.transaction_id === trxId);
            if (!order) return;

            const modal = document.getElementById('orderDetailModal');
            const content = document.getElementById('modalDetailContent');
            const creds = order.stock_data || order.sn || order.link || '';
            const isPending = (order.status || 'pending').toLowerCase() === 'pending';

            content.innerHTML = `
                <div class="detail-row">
                    <span class="detail-label">ID Transaksi:</span>
                    <span class="detail-value"><code>${order.transaction_id}</code></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Nama Produk:</span>
                    <span class="detail-value">${order.product_name || '-'}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Varian:</span>
                    <span class="detail-value">${order.variant_name || '-'}</span>
                </div>
                ${order.target ? `
                <div class="detail-row">
                    <span class="detail-label">Tujuan / Kontak:</span>
                    <span class="detail-value">${order.target}</span>
                </div>
                ` : ''}
                <div class="detail-row">
                    <span class="detail-label">Total Pembayaran:</span>
                    <span class="detail-value" style="color: #28a745; font-size: 1.05rem;">${formatRupiah(order.amount)}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status Pesanan:</span>
                    <span class="detail-value" id="modalStatusBadge">${renderStatusBadge(order.status)}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Tanggal Pembuatan:</span>
                    <span class="detail-value">${order.created_at || '-'}</span>
                </div>

                ${creds ? `
                <div class="credentials-box">
                    <div class="credentials-header">
                        <span>🔑 DATA AKUN / VOUCHER / SERIAL NUMBER</span>
                        <button type="button" class="btn-copy-creds" onclick="copyCredentials('${encodeURIComponent(creds)}')">📋 Salin Data</button>
                    </div>
                    <div class="credentials-content">${creds}</div>
                </div>
                ` : ''}

                ${isPending ? `
                <div class="qris-modal-box">
                    <b style="color: #92400e; font-size: 0.9rem;">⏳ Menunggu Pembayaran QRIS</b>
                    ${order.qr_image_url ? `
                        <img src="${order.qr_image_url}" alt="QRIS" class="qris-modal-img" />
                    ` : ''}
                    <button type="button" class="btn-check-live" id="btnLiveCheck" onclick="checkLiveStatus('${order.transaction_id}')">
                        🔄 Cek Status Pembayaran Real-Time
                    </button>
                </div>
                ` : ''}
            `;

            modal.classList.add('active');
        }

        async function checkLiveStatus(trxId) {
            const btn = document.getElementById('btnLiveCheck');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '🔄 Memeriksa...';
            }

            try {
                const res = await fetch(`${API_BASE_URL}/api/order/status/${trxId}`);
                const data = await res.json();
                if (res.ok && data.success) {
                    const rawSt = (data.status || 'pending').toLowerCase();
                    const newStatus = (rawSt === 'paid' || rawSt === 'success' || rawSt === 'completed' || rawSt === 'settlement') ? 'paid' : rawSt;

                    // Update in memory & storage
                    const updated = ordersData.map(o => {
                        if (o.transaction_id === trxId) {
                            return {
                                ...o,
                                status: newStatus,
                                stock_data: data.stock_data || o.stock_data,
                                sn: data.sn || o.sn,
                                link: data.link || o.link
                            };
                        }
                        return o;
                    });
                    ordersData = updated;
                    try {
                        localStorage.setItem('easymall_orders', JSON.stringify(ordersData));
                    } catch(e){}
                    
                    renderOrders(ordersData);
                    openOrderDetail(trxId);

                    if (newStatus === 'paid') {
                        alert('🎉 Pembayaran terverifikasi! Pesanan Anda telah lunas dan data produk telah tersedia.');
                    } else if (newStatus === 'expired') {
                        alert('⌛ Pesanan telah kadaluwarsa karena tidak dibayar.');
                    } else if (newStatus === 'failed') {
                        alert('❌ Transaksi gagal atau dibatalkan.');
                    } else {
                        alert('⏳ Pembayaran belum terdeteksi. Silakan selesaikan scan QRIS terlebih dahulu.');
                    }
                } else {
                    alert('Gagal memeriksa status pembayaran.');
                }
            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan jaringan saat memeriksa status.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '🔄 Cek Status Pembayaran Real-Time';
                }
            }
        }

        function copyCredentials(encodedCreds) {
            try {
                const text = decodeURIComponent(encodedCreds);
                navigator.clipboard.writeText(text);
                alert('✅ Data akun/voucher berhasil disalin ke clipboard!');
            } catch (e) {
                alert('Gagal menyalin teks.');
            }
        }

        function closeOrderDetail() {
            const modal = document.getElementById('orderDetailModal');
            if (modal) modal.classList.remove('active');
        }

        function handleBackdropClick(e) {
            if (e.target.id === 'orderDetailModal') {
                closeOrderDetail();
            }
        }

        function searchOrders() {
            const query = document.getElementById('searchOrderInput').value.trim().toLowerCase();
            if (!query) {
                renderOrders(ordersData);
                return;
            }

            const filtered = ordersData.filter(o => 
                (o.transaction_id && o.transaction_id.toLowerCase().includes(query)) ||
                (o.product_name && o.product_name.toLowerCase().includes(query)) ||
                (o.variant_name && o.variant_name.toLowerCase().includes(query))
            );
            renderOrders(filtered);
        }

        function showNoData() {
            document.getElementById('table-container').innerHTML = '<div class="no-data">Gagal memuat daftar pesanan.</div>';
        }

        async function performLogout() {
            try {
                await fetch(`${API_BASE_URL}/logout`, { credentials: 'include' });
            } catch(e){}
            try {
                localStorage.removeItem('em_session_data');
                localStorage.removeItem('em_user_session');
                localStorage.removeItem('session_id');
                document.cookie = "session_id=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                document.cookie = "em_session_data=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
            } catch(e){}
            window.location.href = '/login';
        }

        fetchUserData();
    </script>
    <BottomNav />
</body>
</html>
