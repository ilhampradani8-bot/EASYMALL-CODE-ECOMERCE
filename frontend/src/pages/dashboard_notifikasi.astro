---
// dashboard_notifikasi.astro
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifikasi Saya | EasyMall</title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <style is:global>
        :root {
            --bg-color: #f5f5f7;
            --text-color: #1d1d1f;
            --border-color: rgba(0, 0, 0, 0.08);
            --apple-blue: #007aff;
            --apple-card-bg: #ffffff;
            --font-apple: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-apple);
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        /* Fullwidth macOS Desktop Layout */
        .container {
            max-width: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            flex-grow: 1;
            display: grid;
            grid-template-columns: 240px 1fr;
            min-height: calc(100vh - 62px);
            background: #f5f5f7;
        }

        .sidebar-col {
            background: #f6f8fa;
            border-right: 1px solid var(--border-color);
            padding: 1.25rem 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
        }

        .content-area {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
            padding: 1.5rem 2rem;
            overflow-y: auto;
        }

        .card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .card-header {
            background: #fafafa;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            font-size: 1.05rem;
            color: #1d1d1f;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-body {
            padding: 1.25rem;
        }

        /* Filter Tabs */
        .tabs-header {
            display: flex;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 1.5rem;
        }

        .tab-btn {
            background: none;
            border: none;
            padding: 0.75rem 1.25rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: #86868b;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
            border-radius: 8px 8px 0 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .tab-btn:hover {
            color: #007aff;
            background: rgba(0, 122, 255, 0.04);
        }

        .tab-btn.active {
            color: #007aff;
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 2.5px;
            background-color: #007aff;
            border-radius: 3px;
        }

        .badge-count {
            background: #f0f0f2;
            color: #636366;
            font-size: 0.75rem;
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 700;
        }

        .tab-btn.active .badge-count {
            background: #e7f1ff;
            color: #007aff;
        }

        /* Notification List */
        .notif-list-wrapper {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .notif-card-item {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            display: flex;
            gap: 16px;
            position: relative;
            transition: all 0.2s ease;
        }

        .notif-card-item:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
            border-color: rgba(0, 0, 0, 0.12);
        }

        .notif-card-item.unread {
            background: #fbfbfd;
            border-left: 4px solid #007aff;
        }

        .notif-icon-box {
            font-size: 1.3rem;
            width: 44px;
            height: 44px;
            background: #f5f5f7;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #1d1d1f;
            border: 1px solid var(--border-color);
        }

        .notif-card-item.unread .notif-icon-box {
            background: #e7f1ff;
            color: #007aff;
            border-color: rgba(0, 122, 255, 0.2);
        }

        .notif-details {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-grow: 1;
        }

        .notif-title-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .notif-title {
            font-weight: 600;
            font-size: 0.98rem;
            color: #1d1d1f;
        }

        .notif-time {
            font-size: 0.8rem;
            color: #86868b;
            white-space: nowrap;
        }

        .notif-message {
            font-size: 0.9rem;
            color: #515154;
            line-height: 1.45;
        }

        .notif-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 8px;
            border-top: 1px solid rgba(0,0,0,0.04);
            padding-top: 8px;
        }

        .btn-action-link {
            background: none;
            border: none;
            color: #007aff;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            padding: 0;
            transition: color 0.15s;
        }

        .btn-action-link:hover {
            color: #0056b3;
            text-decoration: underline;
        }

        .btn-action-link.delete-btn {
            color: #ff3b30;
        }

        .btn-action-link.delete-btn:hover {
            color: #d70015;
        }

        .no-data {
            padding: 3rem;
            text-align: center;
            color: #86868b;
        }

        .loading-spinner {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            color: #007aff;
            gap: 10px;
            font-size: 0.9rem;
        }

        .spinner {
            width: 24px;
            height: 24px;
            border: 2px solid rgba(0, 122, 255, 0.15);
            border-top-color: #007aff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        .btn-primary-sm {
            background: #007aff;
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary-sm:hover {
            background: #0062cc;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Responsive Layout */
        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden;
                width: 100%;
            }
            body {
                padding-bottom: 74px !important;
            }
            .container {
                grid-template-columns: 1fr;
                padding: 0 0.75rem;
                margin: 1rem auto;
            }
            .content-area {
                min-width: 0;
                width: 100%;
            }
            .sidebar-col {
                display: none !important;
            }
            .notif-title-row {
                flex-direction: column;
                gap: 4px;
            }
        }
    </style>
</head>
<body>
    <!-- User Navbar Component -->
    <UserNavbar />

    <!-- Container Layout -->
    <div class="container">
        <!-- Sidebar Column -->
        <div class="sidebar-col">
            <UserSidebar activeTab="notifikasi" />
        </div>

        <!-- Main Content Area -->
        <div class="content-area">
            <div class="card">
                <div class="card-header">
                    <span>🔔 Notifikasi Saya</span>
                    <button class="btn-primary-sm" id="btnMarkAllReadPage" style="display: none;">Tandai Semua Dibaca</button>
                </div>
                <div class="card-body">
                    <!-- Tabs -->
                    <div class="tabs-header">
                        <button class="tab-btn active" id="tabAll" onclick="changeTab('all')">
                            Semua
                            <span class="badge-count" id="countAll">0</span>
                        </button>
                        <button class="tab-btn" id="tabUnread" onclick="changeTab('unread')">
                            Belum Dibaca
                            <span class="badge-count" id="countUnread" style="background: #dc3545; color: white;">0</span>
                        </button>
                        <button class="tab-btn" id="tabRead" onclick="changeTab('read')">
                            Sudah Dibaca
                            <span class="badge-count" id="countRead">0</span>
                        </button>
                    </div>

                    <!-- Notification List -->
                    <div id="notificationsListContainer">
                        <div class="loading-spinner">
                            <div class="spinner"></div>
                            Memuat notifikasi...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation for Mobile -->
    <BottomNav />

    <script is:inline>
        let API_BASE_URL = '';
        if (window.location.port !== '5002' && window.location.protocol !== 'file:') {
            API_BASE_URL = '';
        }

        let allNotifications = [];
        let activeFilter = 'all';

        async function fetchNotificationsPageData() {
            const localToken = localStorage.getItem('em_session_data') || localStorage.getItem('session_id') || '';
            const authHeaders = localToken ? { 'Authorization': `Bearer ${localToken}` } : {};

            try {
                // 1. Check user login status
                const authRes = await fetch(`${API_BASE_URL}/api/auth/status`, {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache', ...authHeaders }
                });
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (!authData.logged_in) {
                        const cached = localStorage.getItem('em_user_session');
                        if (!cached && !localToken) {
                            const cookies = document.cookie || '';
                            if (!cookies.includes('session_id=') && !cookies.includes('em_session_data=')) {
                                window.location.replace('/login');
                                return;
                            }
                        }
                    }
                }
            } catch (err) {
                console.warn('Network issue fetching auth status in notifications:', err);
            }

            try {
                // 2. Fetch Notifications list
                const res = await fetch(`${API_BASE_URL}/api/notifications`, { credentials: 'include' });
                if (res.ok) {
                    const data = await res.json();
                    allNotifications = data.notifications || [];
                    updateTabsCount();
                    renderFilteredNotifications();
                } else {
                    showError();
                }
            } catch (err) {
                console.error(err);
                showError();
            }
        }

        function updateTabsCount() {
            const total = allNotifications.length;
            const unread = allNotifications.filter(n => n.is_read === 0).length;
            const read = total - unread;

            document.getElementById('countAll').textContent = total;
            document.getElementById('countUnread').textContent = unread;
            document.getElementById('countRead').textContent = read;

            const markAllBtn = document.getElementById('btnMarkAllReadPage');
            if (markAllBtn) {
                markAllBtn.style.display = unread > 0 ? 'inline-block' : 'none';
            }
        }

        function renderFilteredNotifications() {
            const container = document.getElementById('notificationsListContainer');
            if (!container) return;

            let filtered = [];
            if (activeFilter === 'all') {
                filtered = allNotifications;
            } else if (activeFilter === 'unread') {
                filtered = allNotifications.filter(n => n.is_read === 0);
            } else if (activeFilter === 'read') {
                filtered = allNotifications.filter(n => n.is_read === 1);
            }

            if (filtered.length === 0) {
                container.innerHTML = `<div class="no-data">Tidak ada notifikasi dalam filter ini.</div>`;
                return;
            }

            container.innerHTML = `
                <div class="notif-list-wrapper">
                    ${filtered.map(n => {
                        const isUnread = n.is_read === 0 ? 'unread' : '';
                        let icon = '🔔';
                        if (n.type === 'order') icon = '📦';
                        else if (n.type === 'success') icon = '✅';

                        const readActionBtn = n.is_read === 0 
                            ? `<button class="btn-action-link" onclick="markPageNotifRead(${n.id})">Tandai Dibaca</button>`
                            : '';

                        return `
                            <div class="notif-card-item ${isUnread}">
                                <div class="notif-icon-box">${icon}</div>
                                <div class="notif-details">
                                    <div class="notif-title-row">
                                        <span class="notif-title">${n.title}</span>
                                        <span class="notif-time">${n.created_at}</span>
                                    </div>
                                    <p class="notif-message">${n.message}</p>
                                    <div class="notif-actions">
                                        ${readActionBtn}
                                        ${n.type === 'order' ? `<button class="btn-action-link" onclick="window.location.href='/dashboard_pesanan'">Lihat Pesanan</button>` : ''}
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;
        }

        window.changeTab = function(tabName) {
            activeFilter = tabName;
            
            // Toggle active classes
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            if (tabName === 'all') document.getElementById('tabAll').classList.add('active');
            else if (tabName === 'unread') document.getElementById('tabUnread').classList.add('active');
            else if (tabName === 'read') document.getElementById('tabRead').classList.add('active');

            renderFilteredNotifications();
        };

        window.markPageNotifRead = async function(id) {
            try {
                const res = await fetch(`${API_BASE_URL}/api/notifications/read/${id}`, { 
                    method: 'POST', 
                    credentials: 'include' 
                });
                if (res.ok) {
                    // Update local state
                    const notif = allNotifications.find(n => n.id === id);
                    if (notif) notif.is_read = 1;
                    
                    updateTabsCount();
                    renderFilteredNotifications();
                    
                    // Also refresh navbar unread count if badge exists
                    if (window.fetchNotifCount) {
                        window.fetchNotifCount();
                    }
                }
            } catch (e){}
        };

        function showError() {
            const container = document.getElementById('notificationsListContainer');
            if (container) {
                container.innerHTML = `<div class="no-data">Gagal memuat data notifikasi. Silakan coba lagi.</div>`;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const markAllBtn = document.getElementById('btnMarkAllReadPage');
            if (markAllBtn) {
                markAllBtn.addEventListener('click', async () => {
                    try {
                        const res = await fetch(`${API_BASE_URL}/api/notifications/read`, { 
                            method: 'POST', 
                            credentials: 'include' 
                        });
                        if (res.ok) {
                            allNotifications.forEach(n => n.is_read = 1);
                            updateTabsCount();
                            renderFilteredNotifications();
                            if (window.fetchNotifCount) {
                                window.fetchNotifCount();
                            }
                        }
                    } catch (e){}
                });
            }

            fetchNotificationsPageData();
        });
    </script>
</body>
</html>
