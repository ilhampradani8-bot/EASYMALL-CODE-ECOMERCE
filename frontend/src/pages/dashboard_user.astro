---
// dashboard_user.astro
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import WelcomeCard from '../components/dashboard/WelcomeCard.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Pelanggan | EasyMall</title>
    
    <!-- Favicon & App Icons -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
    
    <style is:global>
        :root {
            --bg-color: #f5f5f7;
            --text-color: #1d1d1f;
            --border-color: rgba(0, 0, 0, 0.08);
            --apple-blue: #007aff;
            --apple-card-bg: #ffffff;
            --font-apple: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-apple);
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        /* Fullwidth macOS Desktop Layout */
        .container {
            max-width: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            flex-grow: 1;
            display: grid;
            grid-template-columns: 240px 1fr;
            min-height: calc(100vh - 62px);
            background: #f5f5f7;
        }

        .sidebar-col {
            background: #f6f8fa;
            border-right: 1px solid var(--border-color);
            padding: 1.25rem 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
        }

        .content-area {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
            padding: 1.5rem 2rem;
            overflow-y: auto;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
        }

        @media (max-width: 576px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        }

        .stat-icon-wrapper {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .stat-icon-wrapper.blue { background-color: #e7f1ff; }
        .stat-icon-wrapper.green { background-color: #e8f9ee; }
        .stat-icon-wrapper.purple { background-color: #f3ebff; }

        .stat-details {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .stat-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #86868b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1d1d1f;
        }

        /* Chart Card */
        .chart-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .chart-header {
            background: #fafafa;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--border-color);
        }

        .chart-header h4 {
            font-size: 1rem;
            font-weight: 700;
            color: #1d1d1f;
            margin-bottom: 2px;
        }

        .chart-header p {
            font-size: 0.8rem;
            color: #86868b;
            margin: 0;
        }

        .chart-body {
            padding: 1.5rem;
            position: relative;
            height: 320px;
            width: 100%;
        }

        /* Responsive Layout */
        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden;
                width: 100%;
            }
            body {
                padding-bottom: 74px !important;
            }
            .container {
                grid-template-columns: 1fr;
                min-height: auto;
            }
            .content-area {
                min-width: 0;
                width: 100%;
                padding: 1rem 0.85rem;
            }
            .sidebar-col {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar Component -->
    <UserNavbar />

    <!-- Main Container -->
    <div class="container">
        <!-- Sidebar profile & menu -->
        <div class="sidebar-col">
            <UserSidebar activeTab="dashboard" />
        </div>

        <!-- Main Content Area -->
        <div class="content-area">
            <!-- Welcome Info -->
            <WelcomeCard />

            <!-- Stats Grid Row -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon-wrapper blue">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d6efd" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                    <div class="stat-details">
                        <span class="stat-label">Total Belanja</span>
                        <h3 class="stat-value" id="stat-total-spent">Rp 0</h3>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrapper green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#198754" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    </div>
                    <div class="stat-details">
                        <span class="stat-label">Total Transaksi</span>
                        <h3 class="stat-value" id="stat-total-tx">0 Transaksi</h3>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrapper purple">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6f42c1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                    </div>
                    <div class="stat-details">
                        <span class="stat-label">Produk Dibeli</span>
                        <h3 class="stat-value" id="stat-total-products">0 Produk</h3>
                    </div>
                </div>
            </div>

            <!-- Chart Card -->
            <div class="chart-card">
                <div class="chart-header">
                    <h4>📈 Grafik Tren Pengeluaran Belanja</h4>
                    <p>Visualisasi tren total belanja harian Anda</p>
                </div>
                <div class="chart-body">
                    <canvas id="userSpendingChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        let API_BASE_URL = '';
        if (window.location.port !== '5002' && window.location.protocol !== 'file:') {
            API_BASE_URL = '';
        }

        let transactionsData = [];
        let userEmail = '';
        let myChartInstance = null;

        function formatRupiah(num) {
            if (num === null || num === undefined) return "Rp 0";
            return "Rp " + parseInt(num, 10).toLocaleString('id-ID');
        }

        async function fetchUserData() {
            const localToken = localStorage.getItem('em_session_data') || localStorage.getItem('session_id') || '';
            const authHeaders = localToken ? { 'Authorization': `Bearer ${localToken}` } : {};

            try {
                // Fetch profile
                const authRes = await fetch(`${API_BASE_URL}/api/auth/status`, {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache', ...authHeaders }
                });
                
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (authData.logged_in) {
                        userEmail = authData.email;
                        const nameEl = document.getElementById('user-name');
                        const emailEl = document.getElementById('user-email');
                        const avatarEl = document.getElementById('avatar-initial');
                        if (nameEl) nameEl.textContent = authData.name;
                        if (emailEl) emailEl.textContent = authData.email;
                        if (avatarEl) avatarEl.textContent = (authData.name || 'U').charAt(0).toUpperCase();

                        try {
                            localStorage.setItem('em_user_session', JSON.stringify({ email: authData.email, name: authData.name }));
                        } catch(e){}
                    } else {
                        const cached = localStorage.getItem('em_user_session');
                        if (cached) {
                            try {
                                const parsed = JSON.parse(cached);
                                if (parsed && parsed.email) {
                                    userEmail = parsed.email;
                                    const nameEl = document.getElementById('user-name');
                                    const emailEl = document.getElementById('user-email');
                                    const avatarEl = document.getElementById('avatar-initial');
                                    if (nameEl) nameEl.textContent = parsed.name || parsed.email;
                                    if (emailEl) emailEl.textContent = parsed.email;
                                    if (avatarEl) avatarEl.textContent = (parsed.name || 'U').charAt(0).toUpperCase();
                                }
                            } catch(e){}
                        } else {
                            const cookies = document.cookie || '';
                            if (!cookies.includes('session_id=') && !cookies.includes('em_session_data=') && !localToken) {
                                window.location.replace('/login');
                                return;
                            }
                        }
                    }
                }
            } catch (err) {
                console.warn('Network issue fetching auth status in dashboard_user:', err);
                const cached = localStorage.getItem('em_user_session');
                if (cached) {
                    try {
                        const parsed = JSON.parse(cached);
                        if (parsed && parsed.email) {
                            userEmail = parsed.email;
                            const nameEl = document.getElementById('user-name');
                            const emailEl = document.getElementById('user-email');
                            const avatarEl = document.getElementById('avatar-initial');
                            if (nameEl) nameEl.textContent = parsed.name || parsed.email;
                            if (emailEl) emailEl.textContent = parsed.email;
                            if (avatarEl) avatarEl.textContent = (parsed.name || 'U').charAt(0).toUpperCase();
                        }
                    } catch(e){}
                }
            }

            try {
                // Fetch dashboard data
                let localOrders = [];
                try {
                    localOrders = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                } catch (e) {}

                const dataRes = await fetch(`${API_BASE_URL}/api/dashboard/data`, { 
                    credentials: 'include',
                    headers: authHeaders
                });
                let serverOrders = [];
                if (dataRes.ok) {
                    const res = await dataRes.json();
                    if (res.success && Array.isArray(res.transactions)) {
                        serverOrders = res.transactions;
                    }
                }

                // Merge deduplicated
                const orderMap = new Map();
                localOrders.forEach(o => { if (o && o.transaction_id) orderMap.set(o.transaction_id, o); });
                serverOrders.forEach(o => {
                    if (o && o.transaction_id) {
                        const existing = orderMap.get(o.transaction_id) || {};
                        orderMap.set(o.transaction_id, { ...existing, ...o });
                    }
                });

                transactionsData = Array.from(orderMap.values());
                try {
                    localStorage.setItem('easymall_orders', JSON.stringify(transactionsData));
                } catch(e){}

                renderDashboardStatsAndCharts(transactionsData);
            } catch (err) {
                console.error('Error fetching dashboard data:', err);
                try {
                    transactionsData = JSON.parse(localStorage.getItem('easymall_orders') || '[]');
                    renderDashboardStatsAndCharts(transactionsData);
                } catch (e) {
                    renderDashboardStatsAndCharts([]);
                }
            }
        }

        function renderDashboardStatsAndCharts(list) {
            // Filter ONLY successful/paid transactions for customer spending stats and charts
            const successList = list.filter(t => {
                const st = (t.status || '').toLowerCase().trim();
                return st === 'paid' || st === 'success' || st === 'settlement' || st === 'done' || st === 'completed';
            });

            // 1. Calculate Stats based ONLY on successful transactions
            let totalSpent = 0;
            let uniqueProducts = new Set();
            
            successList.forEach(t => {
                totalSpent += parseFloat(t.amount || 0);
                if (t.product_name) {
                    uniqueProducts.add(t.product_name);
                }
            });

            document.getElementById('stat-total-spent').textContent = formatRupiah(totalSpent);
            document.getElementById('stat-total-tx').textContent = successList.length + ' Transaksi';
            document.getElementById('stat-total-products').textContent = uniqueProducts.size + ' Produk';

            // 2. Prepare Chart Data (Group by date) from successful transactions only
            const dailyData = {};
            
            // Populate last 7 days as default with 0 values
            const last7Days = [];
            for (let i = 6; i >= 0; i--) {
                const d = new Date();
                d.setDate(d.getDate() - i);
                const dateString = d.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit' });
                last7Days.push(dateString);
                dailyData[dateString] = 0;
            }

            // Fill actual transaction data ONLY for successful transactions
            successList.forEach(t => {
                if (t.created_at) {
                    const datePart = t.created_at.split(' ')[0]; // YYYY-MM-DD
                    if (datePart) {
                        const parts = datePart.split('-');
                        if (parts.length === 3) {
                            const formattedDate = `${parts[2]}/${parts[1]}`; // DD/MM
                            if (dailyData[formattedDate] !== undefined) {
                                dailyData[formattedDate] += parseFloat(t.amount || 0);
                            } else {
                                dailyData[formattedDate] = parseFloat(t.amount || 0);
                            }
                        }
                    }
                }
            });

            // Get labels and values sorted chronologically
            const allDates = Object.keys(dailyData).sort((a, b) => {
                const aParts = a.split('/');
                const bParts = b.split('/');
                return new Date(2026, aParts[1] - 1, aParts[0]) - new Date(2026, bParts[1] - 1, bParts[0]);
            });

            const chartLabels = allDates;
            const chartDataValues = allDates.map(date => dailyData[date]);

            // 3. Render Chart via Chart.js
            const ctx = document.getElementById('userSpendingChart').getContext('2d');
            if (myChartInstance) {
                myChartInstance.destroy();
            }

            myChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Pengeluaran Sukses',
                        data: chartDataValues,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.05)',
                        borderWidth: 3,
                        pointBackgroundColor: '#0d6efd',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Total: ' + formatRupiah(context.raw);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) {
                                        return 'Rp ' + (value / 1000000).toFixed(1) + 'jt';
                                    } else if (value >= 1000) {
                                        return 'Rp ' + (value / 1000).toFixed(0) + 'rb';
                                    }
                                    return 'Rp ' + value;
                                },
                                font: {
                                    size: 10
                                }
                            },
                            grid: {
                                color: '#f1f3f5'
                            }
                        },
                        x: {
                            ticks: {
                                font: {
                                    size: 10
                                }
                            },
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        async function performLogout() {
            try {
                await fetch(`${API_BASE_URL}/logout`, { credentials: 'include' });
            } catch(e){}
            try {
                localStorage.removeItem('em_session_data');
                localStorage.removeItem('em_user_session');
                localStorage.removeItem('session_id');
                document.cookie = "session_id=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                document.cookie = "em_session_data=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
            } catch(e){}
            window.location.href = '/login';
        }

        fetchUserData();
    </script>
    <BottomNav />
</body>
</html>

