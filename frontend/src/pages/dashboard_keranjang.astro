---
// dashboard_keranjang.astro
import UserNavbar from '../components/dashboard/UserNavbar.astro';
import UserSidebar from '../components/dashboard/UserSidebar.astro';
import BottomNav from '../components/BottomNav.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Keranjang Belanja | EasyMall</title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <style>
        :root {
            --bg-color: #f8f9fa;
            --text-color: #212529;
            --border-color: #dee2e6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        .container {
            max-width: 1140px;
            width: 100%;
            margin: 1.5rem auto;
            padding: 0 1rem;
            flex-grow: 1;
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 1.5rem;
        }

        .sidebar-col {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .content-area {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
        }

        .card {
            background: #ffffff;
            border: 2px solid #dee2e6;
            border-radius: 4px;
            overflow: hidden;
        }

        .card-header {
            background: #f8f9fa;
            padding: 0.75rem 1.25rem;
            border-bottom: 2px solid #dee2e6;
            font-weight: bold;
            font-size: 1rem;
            color: #212529;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-body {
            padding: 1.25rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #ffffff;
        }

        th, td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
        }

        th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid var(--border-color);
        }

        tr:hover td {
            background-color: #f1f3f5;
        }

        .btn-delete {
            background: #dc3545;
            color: #ffffff;
            border: none;
            padding: 4px 8px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .btn-delete:hover {
            background: #bb2d3b;
        }

        .cart-summary {
            margin-top: 1.5rem;
            padding: 1.25rem;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-price {
            font-size: 1.2rem;
            font-weight: bold;
            color: #212529;
        }

        .btn-checkout {
            padding: 10px 24px;
            background: #28a745;
            color: white;
            border: 1px solid #28a745;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .btn-checkout:hover {
            background: #218838;
        }

        .no-data {
            padding: 3rem;
            text-align: center;
            color: #6c757d;
        }

        .loading-spinner {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            color: #007bff;
            gap: 10px;
            font-size: 0.9rem;
        }

        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(0, 123, 255, 0.1);
            border-top-color: #007bff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            html, body {
                overflow-x: hidden;
                width: 100%;
            }
            body {
                padding-bottom: 74px !important;
            }
            .container {
                grid-template-columns: 1fr;
                padding: 0 0.75rem;
                margin: 1rem auto;
            }
            .content-area {
                min-width: 0;
                width: 100%;
            }
            .sidebar-col {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <UserNavbar />

    <div class="container">
        <div class="sidebar-col">
            <UserSidebar activeTab="keranjang" />
        </div>

        <div class="content-area">
            <div class="card">
                <div class="card-header">
                    <span>🛒 Keranjang Belanja Saya</span>
                    <button class="btn-delete" style="background: #6c757d;" onclick="clearCart()">Kosongkan Keranjang</button>
                </div>
                <div class="card-body">
                    <div id="cart-container" style="overflow-x: auto;">
                        <div class="loading-spinner">
                            <div class="spinner"></div>
                            Memuat keranjang belanja...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        let API_BASE_URL = '';
        if (window.location.port !== '5002' && window.location.protocol !== 'file:') {
            API_BASE_URL = '';
        }

        let cartItems = [];

        function formatRupiah(num) {
            if (num === null || num === undefined) return "Rp 0";
            return "Rp " + parseInt(num, 10).toLocaleString('id-ID');
        }

        async function fetchUserData() {
            try {
                const authRes = await fetch(`${API_BASE_URL}/api/auth/status`, {
                    credentials: 'include',
                    headers: { 'Cache-Control': 'no-cache' }
                });
                
                if (authRes.ok) {
                    const authData = await authRes.json();
                    if (authData.logged_in) {
                        const nameEl = document.getElementById('user-name');
                        const emailEl = document.getElementById('user-email');
                        const avatarEl = document.getElementById('avatar-initial');
                        if (nameEl) nameEl.textContent = authData.name;
                        if (emailEl) emailEl.textContent = authData.email;
                        if (avatarEl) avatarEl.textContent = authData.name.charAt(0).toUpperCase();
                    } else {
                        const cookies = document.cookie || '';
                        if (!cookies.includes('session_id=') && !cookies.includes('em_session_data=')) {
                            // Don't forcefully redirect if user just wants to view their local cart
                            console.log('Guest user browsing cart');
                        }
                    }
                }
            } catch (err) {
                console.warn('Network issue fetching auth status in dashboard_keranjang:', err);
            }

            await fetchCartItems();
        }

        async function fetchCartItems() {
            try {
                let items = [];
                
                // 1. Try reading from server API
                try {
                    const res = await fetch(`${API_BASE_URL}/api/cart`, { 
                        credentials: 'include',
                        headers: { 'Cache-Control': 'no-cache' }
                    });
                    if (res.ok) {
                        const data = await res.json();
                        if (Array.isArray(data)) {
                            items = data;
                        } else if (data && Array.isArray(data.items)) {
                            items = data.items;
                        } else if (data && Array.isArray(data.data)) {
                            items = data.data;
                        }
                    }
                } catch (apiErr) {
                    console.warn('Cart API fetch failed, checking local storage:', apiErr);
                }

                // 2. Sync with localStorage
                try {
                    const localCart = JSON.parse(localStorage.getItem('easymall_cart') || '[]');
                    if (Array.isArray(localCart) && localCart.length > 0) {
                        if (items.length === 0) {
                            items = localCart;
                        } else {
                            localCart.forEach(loc => {
                                const exists = items.some(it => it.product_code === loc.product_code && it.variant_code === loc.variant_code);
                                if (!exists) items.push(loc);
                            });
                        }
                    }
                } catch (lsErr) {
                    console.warn('LocalStorage error:', lsErr);
                }

                cartItems = items;
                renderCart();
            } catch (e) {
                console.error('Error in fetchCartItems:', e);
                // Fallback to local storage
                try {
                    const localCart = JSON.parse(localStorage.getItem('easymall_cart') || '[]');
                    cartItems = Array.isArray(localCart) ? localCart : [];
                    renderCart();
                } catch(err) {
                    showNoData();
                }
            }
        }

        function renderCart() {
            const container = document.getElementById('cart-container');
            if (!container) return;

            if (!cartItems || cartItems.length === 0) {
                container.innerHTML = `
                    <div class="no-data">
                        <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🛒</div>
                        <div style="font-weight: 600; font-size: 1.1rem; color: #333; margin-bottom: 0.5rem;">Keranjang Belanja Anda Kosong</div>
                        <p style="color: #6c757d; font-size: 0.9rem; margin-bottom: 1.25rem;">Belum ada produk yang ditambahkan ke keranjang belanja Anda.</p>
                        <a href="/" style="display: inline-block; background: #007bff; color: white; padding: 8px 18px; border-radius: 4px; text-decoration: none; font-weight: 600; font-size: 0.9rem;">Mulai Belanja</a>
                    </div>
                `;
                return;
            }

            let total = 0;
            const rows = cartItems.map(item => {
                const qty = item.quantity || 1;
                const price = item.price || 0;
                const itemTotal = price * qty;
                total += itemTotal;
                const prodCode = item.product_code || '';
                const detailUrl = prodCode ? `/produk/${encodeURIComponent(prodCode)}` : '#';

                return `
                    <tr>
                        <td>
                            <a href="${detailUrl}" style="text-decoration: none; color: inherit;">
                                <div style="font-weight: 700; color: #007bff;">${item.product_name || 'Produk EasyMall'}</div>
                            </a>
                            <div style="font-size: 0.8rem; color: #6c757d; margin-top: 3px;">
                                <code>${prodCode}</code> ${item.variant_name ? `• Varian: <span style="color:#333; font-weight:600;">${item.variant_name}</span>` : ''}
                            </div>
                        </td>
                        <td style="white-space: nowrap;">${formatRupiah(price)}</td>
                        <td style="text-align: center; font-weight: 600;">${qty}</td>
                        <td style="font-weight: bold; color: #28a745; white-space: nowrap;">${formatRupiah(itemTotal)}</td>
                        <td style="white-space: nowrap;">
                            <div style="display: flex; gap: 6px; align-items: center;">
                                <a href="${detailUrl}" style="background: #007bff; color: white; padding: 4px 10px; border-radius: 4px; text-decoration: none; font-size: 0.8rem; font-weight: bold; display: inline-block;">Beli</a>
                                <button class="btn-delete" onclick="deleteItem('${item.id || item.product_code}')">Hapus</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            container.innerHTML = `
                <div style="overflow-x: auto; width: 100%;">
                    <table style="min-width: 580px;">
                        <thead>
                            <tr>
                                <th>Produk</th>
                                <th>Harga</th>
                                <th style="text-align: center;">Jumlah</th>
                                <th>Total</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rows}
                        </tbody>
                    </table>
                </div>
                <div class="cart-summary">
                    <div>
                        <div style="font-size: 0.85rem; color: #6c757d;">Total Pembayaran (${cartItems.length} Produk):</div>
                        <div class="total-price">${formatRupiah(total)}</div>
                    </div>
                    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <button class="btn-checkout" onclick="checkoutAllCart(${total})">Checkout Semua (${formatRupiah(total)})</button>
                    </div>
                </div>
            `;
        }

        async function deleteItem(id) {
            if (!confirm('Apakah Anda yakin ingin menghapus produk ini dari keranjang?')) return;
            try {
                // Update local state and localStorage
                cartItems = cartItems.filter(item => String(item.id) !== String(id) && String(item.product_code) !== String(id));
                try {
                    localStorage.setItem('easymall_cart', JSON.stringify(cartItems));
                } catch(e){}
                renderCart();

                // Notify API
                await fetch(`${API_BASE_URL}/api/cart?id=${encodeURIComponent(id)}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
            } catch (err) {
                console.error('Error deleting cart item:', err);
            }
        }

        async function clearCart() {
            if (!cartItems || cartItems.length === 0) return;
            if (!confirm('Apakah Anda yakin ingin mengosongkan seluruh isi keranjang?')) return;
            try {
                cartItems = [];
                try {
                    localStorage.removeItem('easymall_cart');
                } catch(e){}
                renderCart();

                await fetch(`${API_BASE_URL}/api/cart`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
            } catch (err) {
                console.error('Error clearing cart:', err);
            }
        }

        async function checkoutAllCart(total) {
            if (!cartItems || cartItems.length === 0) {
                alert('Keranjang belanja kosong.');
                return;
            }

            // If there's 1 item, redirect to its detail page to complete full payment / target input
            if (cartItems.length === 1) {
                const first = cartItems[0];
                if (first.product_code) {
                    window.location.href = `/produk/${encodeURIComponent(first.product_code)}`;
                    return;
                }
            }

            const targetPhone = prompt("Masukkan nomor WhatsApp / Nomor Tujuan untuk konfirmasi pesanan:", "");
            if (!targetPhone) return;

            try {
                alert(`Memproses checkout untuk ${cartItems.length} produk dengan total ${formatRupiah(total)}...`);
                
                // Clear cart locally
                cartItems = [];
                try {
                    localStorage.removeItem('easymall_cart');
                } catch(e){}
                renderCart();

                try {
                    await fetch(`${API_BASE_URL}/api/cart`, {
                        method: 'DELETE',
                        credentials: 'include'
                    });
                } catch(e){}

                window.location.href = '/dashboard_pesanan';
            } catch (err) {
                console.error('Checkout error:', err);
                alert('Terjadi kesalahan saat memproses checkout.');
            }
        }

        function showNoData() {
            const container = document.getElementById('cart-container');
            if (container) {
                container.innerHTML = `
                    <div class="no-data">
                        <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⚠️</div>
                        <div style="font-weight: 600; font-size: 1.1rem; color: #333; margin-bottom: 0.5rem;">Tidak dapat memuat keranjang</div>
                        <p style="color: #6c757d; font-size: 0.9rem; margin-bottom: 1.25rem;">Gagal menghubungkan ke server keranjang. Silakan coba muat ulang.</p>
                        <button onclick="fetchCartItems()" style="background: #007bff; color: white; border: none; padding: 8px 18px; border-radius: 4px; font-weight: 600; cursor: pointer;">Muat Ulang</button>
                    </div>
                `;
            }
        }

        async function performLogout() {
            try {
                await fetch(`${API_BASE_URL}/logout`, { credentials: 'include' });
            } catch(e){}
            window.location.href = '/login';
        }

        fetchUserData();
    </script>
    <BottomNav />
</body>
</html>
